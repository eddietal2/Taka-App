# Base URL of the taka-server-resident API. Every call in src/api/* is built as
# `${EXPO_PUBLIC_API_URL}${path}`, and each path already starts with /api/v1, so
# do not add a trailing slash here.
#
# Expo inlines EXPO_PUBLIC_* variables at build time, so this value is bundled
# into the app rather than read at runtime: restart the dev server after changing
# it, and set it per profile in EAS for production builds.
#
# Point this at http://localhost:3000 to use a locally running server instead.
EXPO_PUBLIC_API_URL=https://taka-server-resident.vercel.app
